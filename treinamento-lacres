<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Treinamento - Lacres em Baús e Containers</title>
<style>
:root{
  --blue:#0078d4;
  --blue2:#005a9e;
  --blue3:#00a8ff;
  --ink:#10233f;
  --muted:#51657f;
  --line:rgba(20,61,110,.10);
  --surface:rgba(255,255,255,.92);
  --shadow:0 9px 24px rgba(8,48,92,.12);
  --radius:14px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
  font-weight:400;
  color:var(--ink);
  min-height:100vh;
  padding:22px;
  overflow-x:hidden;
  display:flex;justify-content:center;
  background:
    radial-gradient(circle at 8% 12%,rgba(0,168,255,.32),transparent 24%),
    radial-gradient(circle at 90% 8%,rgba(0,120,212,.28),transparent 27%),
    linear-gradient(135deg,#003f78 0%,#0078d4 27%,#0a68b5 52%,#0065ad 74%,#00467f 100%);
  background-size:170% 170%;
  animation:aurora 18s ease-in-out infinite alternate;
}
@keyframes aurora{
  0%{background-position:0% 45%}
  50%{background-position:100% 55%}
  100%{background-position:45% 100%}
}
body:before,body:after{
  content:"";position:fixed;z-index:-1;border-radius:50%;pointer-events:none;
  filter:blur(2px);opacity:.42;
}
body:before{width:420px;height:420px;left:-170px;top:38%;background:radial-gradient(circle,rgba(0,190,255,.34),transparent 68%)}
body:after{width:500px;height:500px;right:-230px;bottom:-150px;background:radial-gradient(circle,rgba(0,93,190,.45),transparent 68%)}

.container{max-width:900px;width:100%;margin:auto}

.header{
  position:relative;overflow:hidden;text-align:center;
  padding:20px 26px 24px;
  margin-bottom:18px;
  border:1px solid rgba(255,255,255,.28);
  border-radius:20px;
  background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,255,255,.08));
  box-shadow:0 20px 56px rgba(0,31,69,.2),inset 0 1px rgba(255,255,255,.24);
  backdrop-filter:blur(18px);
}
.header:after{
  content:"";position:absolute;inset:auto -10% -70% 25%;height:200px;
  background:radial-gradient(ellipse,rgba(255,255,255,.15),transparent 66%);
  pointer-events:none;
}
.logo-container{
  display:inline-flex;align-items:center;justify-content:center;
  padding:9px 15px;border-radius:13px;
  background:rgba(255,255,255,.94);
  box-shadow:0 8px 22px rgba(0,25,70,.16);
  margin-bottom:14px;
}
.logo-container img{max-width:175px;max-height:50px;display:block;object-fit:contain}
.header h1{
  color:#fff;font-size:clamp(26px,4vw,36px);letter-spacing:-.4px;
  line-height:1.15;margin-bottom:8px;font-weight:500;
  text-shadow:0 4px 20px rgba(0,0,0,.2)
}
.header p{color:rgba(255,255,255,.9);font-size:14px;font-weight:400}

.container-main{
  background:var(--surface);
  border:1px solid rgba(255,255,255,.76);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  backdrop-filter:blur(14px);
  overflow:hidden;
}

.content{padding:clamp(20px,4.5vw,40px)}

.slide{display:none;animation:fadeIn .5s}
.slide.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

.slide h2{
  color:var(--ink);margin-bottom:20px;
  font-size:clamp(21px,3.6vw,27px);font-weight:500;line-height:1.3
}
.slide h3{
  color:var(--blue2);margin-top:20px;margin-bottom:12px;
  font-size:clamp(15px,2.8vw,17.5px);font-weight:500
}
.slide p{color:#3c4c63;line-height:1.75;margin-bottom:14px;font-size:clamp(14.5px,2.4vw,15.5px)}
.slide ul{margin:16px 0;padding-left:0;list-style:none}
.slide li{
  color:#3c4c63;line-height:1.75;margin-bottom:12px;
  font-size:clamp(14px,2.4vw,15px);padding-left:22px;position:relative
}
.slide li:before{
  content:"◆";position:absolute;left:0;color:var(--blue);
  font-weight:bold;font-size:11px;top:6px
}
.slide strong{color:var(--ink);font-weight:600}

.icon-list{display:flex;flex-direction:column;gap:12px;margin:18px 0}
.icon-item{
  display:flex;align-items:center;gap:16px;
  background:linear-gradient(145deg,#eef2fa,#e2e9f6);
  border:1px solid var(--line);border-radius:12px;
  padding:14px 18px;box-shadow:0 2px 6px rgba(16,35,63,.05)
}
.icon-item-icon{
  font-size:26px;width:44px;height:44px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:rgba(0,120,212,.12);border-radius:10px
}
.icon-item-text{color:var(--ink);font-size:14.5px;line-height:1.5;font-weight:400}

.photo-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
  gap:14px;margin:18px 0
}
.photo-card{
  background:linear-gradient(145deg,#eef2fa,#e2e9f6);
  border:1px solid var(--line);border-radius:12px;overflow:hidden;
  box-shadow:0 2px 6px rgba(16,35,63,.05)
}
.photo-card img{width:100%;height:120px;object-fit:cover;display:block;background:#fff}
.photo-card-label{
  padding:9px 10px;font-size:12.5px;color:var(--ink);font-weight:500;
  text-align:center;line-height:1.3
}

.feature-photo{
  max-width:280px;width:100%;margin:18px auto;display:block;
  border-radius:12px;border:1px solid var(--line);
  box-shadow:0 6px 18px rgba(16,35,63,.12)
}

.info-box,.alert-box,.success-box,.danger-box,.content-box{
  padding:clamp(16px,3.4vw,22px);border-radius:12px;margin:18px 0;
  border-left:4px solid var(--blue);box-shadow:0 2px 8px rgba(8,48,92,.07)
}
.info-box h3,.alert-box h3,.success-box h3,.danger-box h3,.content-box h3{margin-top:0}

.info-box{background:linear-gradient(145deg,#eaf3fc,#dbeafe);border-left-color:#2563eb}
.info-box h3{color:#1e40af}
.info-box li:before{color:#2563eb}

.alert-box{background:linear-gradient(145deg,#fff8e6,#fef3c7);border-left-color:#f59e0b}
.alert-box h3{color:#92400e}
.alert-box li:before{color:#f59e0b}

.success-box{background:linear-gradient(145deg,#e8fbf3,#d1f7e6);border-left-color:#10b981}
.success-box h3{color:#065f46}
.success-box li:before{color:#10b981}

.danger-box{background:linear-gradient(145deg,#fdecec,#fbdada);border-left-color:#ef4444}
.danger-box h3{color:#991b1b}
.danger-box li:before{color:#ef4444}

.content-box{background:linear-gradient(145deg,#eef4fc,#e2ecfb);border-left-color:#3b82f6}

.final-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin:18px 0}
.final-grid .info-box,.final-grid .success-box,.final-grid .content-box,.final-grid .alert-box{margin:0}
.final-grid h3{font-size:14.5px;margin-bottom:6px}
.final-grid p{margin-bottom:0;font-size:13.5px}

.navigation{
  display:flex;justify-content:space-between;margin-top:32px;
  padding-top:20px;border-top:1px solid var(--line);gap:14px
}
.btn{
  padding:11px 26px;border:1px solid transparent;border-radius:10px;
  font-size:13.5px;cursor:pointer;transition:.15s ease;font-weight:600;
  letter-spacing:.2px;user-select:none;touch-action:manipulation;display:inline-block
}
.btn-primary{
  background:linear-gradient(135deg,var(--blue),#005ca9);color:#fff;
  box-shadow:0 7px 16px rgba(0,120,212,.24)
}
.btn-primary:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 11px 22px rgba(0,120,212,.32)}
.btn-primary:active:not(:disabled){transform:translateY(0)}
.btn-secondary{background:#fff;color:#4b5563;border-color:#d1d5db}
.btn-secondary:hover:not(:disabled){background:#f9fafb;border-color:#9ca3af}
.btn:disabled{opacity:.5;cursor:not-allowed}

.progress-bar{height:6px;background:#e5e7eb;border-radius:10px;overflow:hidden;margin-bottom:26px}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--blue3));transition:width .4s ease}

@media(max-width:480px){
  body{padding:12px}
  .slide li{padding-left:24px}
  .navigation{flex-direction:column;gap:10px}
  .btn{width:100%}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{animation:none!important;transition:none!important}
}
</style>
</head>
<body>
<div class="container">
    <div class="header">
        <div class="logo-container">
            <img src="logo-rodorei.png" alt="Logo Rodorei">
        </div>
        <h1>Lacres em Baús e Containers</h1>
        <p style="font-size:clamp(14.5px,3.4vw,17px);font-weight:500;margin-top:10px">Treinamento Obrigatório</p>
        <p style="margin-top:6px">Foco no Programa OEA — Motoristas de Transporte Rodoviário</p>
    </div>

    <div class="container-main">
    <div class="content">
        <div class="progress-bar">
            <div class="progress-fill" id="progressBar"></div>
        </div>

        <!-- Slide 1 -->
        <div class="slide active">
            <h2>Bem-vindo ao Treinamento</h2>
            <p>Este curso aborda o uso correto de lacres em baús e containers, um procedimento essencial para a segurança da carga e para a conformidade com o Programa OEA (Operador Econômico Autorizado).</p>

            <div class="info-box">
                <h3>Objetivo do Treinamento</h3>
                <ul>
                    <li>Reforçar a importância do uso correto de lacres</li>
                    <li>Garantir conformidade com os requisitos do Programa OEA</li>
                    <li>Reforçar a segurança no transporte rodoviário, portos e aeroportos</li>
                    <li>Padronizar procedimentos de conferência e comunicação</li>
                </ul>
            </div>

            <div class="content-box">
                <p style="margin-bottom:6px"><strong>Duração estimada:</strong> 1h - 3h</p>
                <p style="margin-bottom:0"><strong>Formato:</strong> 9 módulos interativos com avaliação final</p>
            </div>
        </div>

        <!-- Slide 2 -->
        <div class="slide">
            <h2>Importância dos Lacres</h2>
            <p>O lacre é o dispositivo responsável por garantir a inviolabilidade da carga durante todo o trajeto, sendo peça-chave para a segurança da cadeia logística e para o cumprimento das exigências do OEA.</p>

            <div class="icon-list">
                <div class="icon-item">
                    <div class="icon-item-icon">🏃</div>
                    <div class="icon-item-text">Prevenção contra roubos e adulterações</div>
                </div>
                <div class="icon-item">
                    <div class="icon-item-icon">✅</div>
                    <div class="icon-item-text">Garante integridade da carga</div>
                </div>
                <div class="icon-item">
                    <div class="icon-item-icon">⚖️</div>
                    <div class="icon-item-text">Atende exigências legais e do Programa OEA</div>
                </div>
                <div class="icon-item">
                    <div class="icon-item-icon">🤝</div>
                    <div class="icon-item-text">Proporciona confiança entre cliente e transportadora</div>
                </div>
            </div>
        </div>

        <!-- Slide 3 -->
        <div class="slide">
            <h2>Tipos de Lacres</h2>
            <p>Existem diferentes modelos de lacres, cada um indicado para um tipo de operação. Conhecer as características de cada um ajuda na conferência correta no dia a dia.</p>

            <div class="photo-grid">
                <div class="photo-card">
                    <img src="data:image/jpeg;base64," alt="Lacre de cinta plástica numerado">
                    <div class="photo-card-label">Cinta Plástica<br>(numerado)</div>
                </div>
                <div class="photo-card">
                    <img src="data:image/jpeg;base64," alt="Lacre de cabo, alta segurança">
                    <div class="photo-card-label">Cabo<br>(alta segurança)</div>
                </div>
                <div class="photo-card">
                    <img src="data:image/jpeg;base64," alt="Lacre tipo cadeado">
                    <div class="photo-card-label">Cadeado</div>
                </div>
                <div class="photo-card">
                    <img src="data:image/jpeg;base64," alt="Lacre tipo pino/parafuso">
                    <div class="photo-card-label">Pino<br>(parafuso)</div>
                </div>
            </div>

            <div class="icon-list">
                <div class="icon-item">
                    <div class="icon-item-icon">📡</div>
                    <div class="icon-item-text">Lacres eletrônicos com rastreamento (tecnologia com chip/RFID integrado)</div>
                </div>
            </div>
        </div>

        <!-- Slide 4 -->
        <div class="slide">
            <h2>Lacre RFB</h2>
            <p>O Lacre da Receita Federal do Brasil (RFB) tem regras específicas de controle e substituição que todo motorista precisa conhecer.</p>

            <img class="feature-photo" src="data:image/jpeg;base64," alt="Exemplo de lacre de cabo numerado">

            <div class="info-box">
                <h3>Pontos de Atenção</h3>
                <ul>
                    <li>O Lacre da Receita Federal substitui o Lacre Rodorei</li>
                    <li>O número do lacre deve ser igual ao lançado no documento de liberação da carga</li>
                    <li>O motorista deve acompanhar a lacração e a quebra do lacre</li>
                    <li>Sempre confirmar se o modelo é idêntico ao exemplo, apontando de imediato qualquer divergência</li>
                </ul>
            </div>
        </div>

        <!-- Slide 5 -->
        <div class="slide">
            <h2>Lacre Rodorei</h2>
            <p>Fora das situações em que o lacre da Receita Federal é utilizado, aplica-se o Lacre Rodorei, com regras próprias de controle e identificação.</p>

            <img class="feature-photo" src="data:image/jpeg;base64," alt="Lacre Rodorei numerado">

            <div class="info-box">
                <h3>Procedimentos Padrão</h3>
                <ul>
                    <li>O lacre deve ser utilizado mesmo para veículos vazios</li>
                    <li>O número do lacre deve constar no Check List do veículo</li>
                    <li>O motorista deve providenciar a lacração e a quebra do lacre</li>
                    <li>Sempre confirmar se o lacre é da empresa, com nome e números sem sinais de adulteração</li>
                    <li>Verificar se o fio do lacre não está rompido</li>
                </ul>
            </div>

            <div class="alert-box">
                <h3>Regras Importantes</h3>
                <ul>
                    <li>A empresa opera apenas com lacres na cor azul, para facilitar a identificação</li>
                    <li>Não ceder lacres a terceiros, mesmo já rompidos (utilizados)</li>
                    <li>Lacrar sempre imediatamente ao carregamento/descarregamento ou ao check list, quando vazio</li>
                </ul>
            </div>
        </div>

        <!-- Slide 6 -->
        <div class="slide">
            <h2>Procedimento do Motorista</h2>
            <p>O motorista tem papel fundamental na conferência e na integridade do lacre ao longo de toda a viagem.</p>

            <div class="info-box">
                <h3>Durante a Viagem</h3>
                <ul>
                    <li>Conferir o número do lacre com a documentação antes da saída</li>
                    <li>Garantir que o lacre esteja intacto e bem fixado</li>
                    <li>Comunicar imediatamente qualquer irregularidade ao gestor imediato</li>
                    <li>Registrar o número do lacre no Check List</li>
                    <li>Em cada parada, checar as condições do lacre, identificando possíveis sinais de violação</li>
                </ul>
            </div>

            <div class="danger-box">
                <h3>Em Caso de Blitz ou Ação Policial</h3>
                <p style="margin-bottom:0">Se for solicitada a quebra do lacre, <strong>não autorize</strong>. Entre em contato imediatamente com o gestor imediato antes de qualquer ação.</p>
            </div>
        </div>

        <!-- Slide 7 -->
        <div class="slide">
            <h2>Conferência e Documentação</h2>
            <p>O registro correto do lacre na documentação é obrigatório e garante rastreabilidade em toda a operação.</p>

            <div class="info-box">
                <ul>
                    <li>Conferência obrigatória no carregamento e na entrega</li>
                    <li>Registrar o número do lacre no CT-e, manifesto ou Check List</li>
                    <li>Assinar e entregar o Check List ao gestor imediato</li>
                    <li>Comunicar de imediato casos de divergência de lacre ou documental</li>
                </ul>
            </div>
        </div>

        <!-- Slide 8 -->
        <div class="slide">
            <h2>Comunicação e Atenção</h2>
            <p>Em ambientes de maior exposição, como portos e aeroportos, a atenção redobrada e a comunicação correta são fundamentais.</p>

            <div class="info-box">
                <ul>
                    <li>Manter atenção redobrada em portos e aeroportos</li>
                    <li>Sempre seguir os canais de comunicação da empresa</li>
                    <li>Relatar qualquer tentativa de violação</li>
                    <li>Agir sempre em conformidade com as regras do OEA obtidas nos treinamentos</li>
                </ul>
            </div>
        </div>

        <!-- Slide 9 -->
        <div class="slide">
            <h2>Considerações Finais</h2>
            <p>O uso correto dos lacres depende do compromisso de cada motorista com os procedimentos e com a segurança da operação.</p>

            <div class="final-grid">
                <div class="info-box">
                    <h3>Lacres</h3>
                    <p>O uso correto de lacres fortalece a segurança da cadeia logística.</p>
                </div>
                <div class="success-box">
                    <h3>Motorista</h3>
                    <p>O motorista é peça fundamental no cumprimento dos requisitos OEA.</p>
                </div>
                <div class="content-box">
                    <h3>Procedimentos</h3>
                    <p>Procedimentos simples evitam grandes riscos.</p>
                </div>
                <div class="alert-box">
                    <h3>Segurança</h3>
                    <p>Segurança, conformidade e confiança são prioridades.</p>
                </div>
            </div>
        </div>

        <!-- Slide 10 -->
        <div class="slide">
            <h2>Parabéns! Treinamento Concluído</h2>
            <p>Você completou com sucesso o treinamento sobre Lacres em Baús e Containers. Agora você está mais preparado para garantir a integridade da carga e a conformidade com o Programa OEA.</p>

            <div class="success-box">
                <h3>Pontos-Chave para Lembrar</h3>
                <ul>
                    <li>Confira sempre o número do lacre com a documentação antes de sair</li>
                    <li>Garanta que o lacre esteja intacto e bem fixado durante toda a viagem</li>
                    <li>A empresa opera apenas com lacres azuis — desconfie de qualquer outra cor</li>
                    <li>Nunca autorize a quebra do lacre em blitz ou ação policial: acione o gestor imediato</li>
                    <li>Registre o número do lacre no Check List, CT-e ou manifesto</li>
                    <li>Comunique imediatamente qualquer divergência ou sinal de violação</li>
                    <li>Mantenha atenção redobrada em portos e aeroportos</li>
                </ul>
            </div>

            <div class="info-box">
                <p style="margin-bottom:0"><strong>Próxima Etapa:</strong> Clique no botão abaixo para responder ao questionário de avaliação e validar seu conhecimento sobre os temas abordados.</p>
            </div>
        </div>

        <div class="completion-message" id="completionMessage" style="display:none;margin-top:32px">
            <div style="background:linear-gradient(135deg,rgba(0,120,212,.08),rgba(16,110,190,.08));backdrop-filter:blur(10px);border:1px solid rgba(0,120,212,.2);padding:32px;border-radius:12px;text-align:center">
                <h2 style="font-size:20px;margin:0 0 10px;font-weight:500;color:var(--ink)">Treinamento Concluído</h2>
                <p style="font-size:14px;color:var(--muted);margin-bottom:20px;line-height:1.5">Parabéns! Você completou todo o conteúdo.<br>Retorne à página inicial para realizar o teste de avaliação.</p>
                <a href="index.html" class="btn btn-primary" style="text-decoration:none">← Voltar ao Início</a>
            </div>
        </div>

        <!-- Navigation -->
        <div class="navigation">
            <button class="btn btn-secondary" id="prevBtn" type="button" onclick="prevSlide()">← Anterior</button>
            <button class="btn btn-primary" id="nextBtn" type="button" onclick="nextSlide()">Próximo →</button>
        </div>
    </div>
    </div>
</div>

<script>
let currentSlide = 0;
const totalSlides = document.querySelectorAll('.slide').length - 1;

function updateProgress() {
    const progress = ((currentSlide + 1) / (totalSlides + 1)) * 100;
    document.getElementById('progressBar').style.width = progress + '%';
}

function showSlide(n) {
    const slides = document.querySelectorAll('.slide');
    slides.forEach(slide => slide.classList.remove('active'));
    if (slides[n]) slides[n].classList.add('active');

    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    if (prevBtn) prevBtn.disabled = n === 0;
    if (nextBtn) nextBtn.textContent = 'Próximo →';

    updateProgress();
    setTimeout(function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }, 100);
}

function nextSlide() {
    if (currentSlide < totalSlides) { currentSlide++; showSlide(currentSlide); }
}
function prevSlide() {
    if (currentSlide > 0) { currentSlide--; showSlide(currentSlide); }
}

document.addEventListener('DOMContentLoaded', function() { showSlide(currentSlide); });
</script>

<script>
(function() {
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initComplete);
    } else {
        initComplete();
    }
    function initComplete() {
        const origShow = window.showSlide;
        if (typeof origShow !== 'function') return;
        window.showSlide = function(n) {
            origShow(n);
            const slides = document.getElementsByClassName('slide');
            const msg = document.getElementById('completionMessage');
            const nextBtn = document.getElementById('nextBtn');
            if (msg && slides.length > 0) {
                if (n === slides.length - 1) {
                    msg.style.display = 'block';
                    if (nextBtn) nextBtn.style.display = 'none';
                } else {
                    msg.style.display = 'none';
                    if (nextBtn) nextBtn.style.display = 'block';
                }
            }
        };
    }
})();
</script>
</body>
</html>
